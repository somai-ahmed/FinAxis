/* Theme Finaxis : sobre, bleu fonce */
QMainWindow, QWidget { font-size: 13px; }
QTabBar::tab { padding: 7px 16px; }
QTabBar::tab:selected { font-weight: bold; border-bottom: 3px solid #1F3864; }
QPushButton { padding: 6px 14px; border: 1px solid #1F3864; border-radius: 4px; background: #D9E2F3; }
QPushButton:hover { background: #B4C7E7; }
QPushButton:pressed { background: #8FAADC; }
QHeaderView::section { background: #1F3864; color: white; padding: 5px; border: none; }
QTableWidget { gridline-color: #D0D0D0; alternate-background-color: #F6F8FC; }
QGroupBox { font-weight: bold; border: 1px solid #BFBFBF; border-radius: 4px; margin-top: 10px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; }
